// prisma/schema.prisma

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}


enum UserType {
  STUDENT
  FACULTY
  ROOT
}

enum OfficialTag {
  // Root / Superadmin
  AAA                 // All Area Access (Full unrestricted root access)

  // Student Official Tags
  TEAMMATE            // Core team student with selected root/admin access (e.g. data curation, OCR studio, fine-tuning)
  STUDENT_COORDINATOR // Student CR / Academic Coordinator
  GENERAL_STUDENT     // Standard enrolled student

  // Faculty Official Tags
  MENTOR              // Faculty Proctor / Mentor
  AOE                 // Area of Expertise / Academic Officer
  FIC                 // Faculty-in-Charge (Labs, Exams, Societies, Curriculum)
  DEAN                // Dean of School / Academics
  HOD                 // Head of Department
  PROFESSOR           // General Teaching Faculty
}

model User {
  id            String       @id @default(cuid())
  name          String?
  email         String       @unique
  image         String?
  hasConsent    Boolean      @default(false)

  // Role & Official Designation
  userType      UserType     @default(STUDENT)
  officialTag   OfficialTag  @default(GENERAL_STUDENT)
  officialTags  OfficialTag[]
  permissions   String[]     @default([])
  department    String?      // e.g. "School of Computer Engineering"
  designation   String?      // e.g. "Dean of Academics", "Core Ingestion Engineer"
  isApproved    Boolean      @default(true)

  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  // Relations placeholders
  academicProfile AcademicProfile?
  
  // Google OAuth Tokens
  accessToken     String?
  refreshToken    String?
  tokenExpiry     DateTime?

  // Classroom specific
  hiddenCourses   HiddenCourse[]
  attendance      AttendanceRecord[]
  healthMetrics   HealthMetric[]

  @@index([userType])
  @@index([officialTag])
}

model AttendanceRecord {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseCode  String
  subjectName String?
  attended    Int
  total       Int
  percentage  Float    @default(0)
  date        DateTime

  @@unique([userId, courseCode, date])
}

model HiddenCourse {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId  String
  createdAt DateTime @default(now())

  @@unique([userId, courseId])
}



// --- REAL ACADEMIC MODELS ---

model AcademicProfile {
  id         String   @id @default(cuid())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id])
  rollNumber String?
  program    String?  // e.g. "B.Tech"
  branch     String?  // e.g. "CSE"
  section    String?  // e.g. "ECSc3"
  cgpa       Float    @default(0.0)
  
  semesters  SemesterRecord[]
}

model SemesterRecord {
  id                String   @id @default(cuid())
  profileId         String
  profile           AcademicProfile @relation(fields: [profileId], references: [id])
  semesterNumber    Int      // 1, 2, 3, etc.
  sgpa              Float
  creditsRegistered Float
  creditsEarned     Float
  remarks           String?  // "PASS", "FAIL"
  
  grades            GradeEntry[]
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Ensure one record per semester per student
  @@unique([profileId, semesterNumber]) 
}

model GradeEntry {
  id          String         @id @default(cuid())
  semesterId  String
  semester    SemesterRecord @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  subjectCode String
  subjectName String
  credits     Float
  grade       String         // "O", "E", "A", etc.
  
  @@unique([semesterId, subjectCode])
}

model StudentDirectory {
  id        String   @id @default(cuid())
  rollNo    String   @unique
  name      String
  section   String
  program   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CourseSchedule {
  id        String @id @default(cuid())
  group     String // e.g. "ECSc1"
  day       String // "MON", "TUE", etc.
  startTime String // e.g. "08:00"
  endTime   String // e.g. "09:00"
  subject   String // e.g. "AD LAB"
  room      String?
  faculty   String?
  
  @@index([group, day])
}

enum OcrStatus {
  PENDING
  APPROVED
  REJECTED
}

model OcrQuestion {
  id             String    @id @default(cuid())
  imagePath      String    // Path to the cropped image in public/dataset/raw
  subject        String?
  subjectCode    String?
  year           String?
  examType       String?
  sourcePdf      String?
  pageNumber     Int?
  // 4 vertices / bounding box coordinates on the PDF page (points)
  bboxX0         Float?
  bboxY0         Float?
  bboxX1         Float?
  bboxY1         Float?
  pageWidth      Float?
  pageHeight     Float?
  rawOcrText     String?   @db.Text
  correctedText  String?   @db.Text
  status         OcrStatus @default(PENDING)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status])
  @@index([subject, year])
}

model HealthMetric {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date            DateTime

  // Sleep Tracking & Recovery
  sleepHours      Float    // e.g. 5.5
  deepSleepMin    Int?     // Deep/REM sleep in minutes
  sleepQuality    Int?     // 1 - 100 score
  bedTime         DateTime?
  wakeTime        DateTime?

  // Biometrics & Daily Vitals
  restingHeartRate Float?  // Average resting BPM
  hrv             Float?   // Heart Rate Variability (ms)
  steps           Int?     @default(0)

  // Self-Reported Cognitive Metrics
  stressLevel     Int      @default(3) // 1 (Relaxed) - 5 (Overwhelmed)
  focusLevel      Int      @default(3) // 1 (Scattered) - 5 (Deep Flow)
  energyLevel     Int      @default(3) // 1 (Exhausted) - 5 (Charged)

  // Calculated Burnout Predictor
  burnoutScore    Float    @default(0) // 0 (Optimal) - 100 (Critical Burnout)
  burnoutRisk     String   @default("LOW") // LOW, MODERATE, HIGH, CRITICAL
  cognitiveCap    Float    @default(100) // % estimated daily capacity
  recoveryAdvice  String?  @db.Text

  source          String   @default("manual") // "apple_shortcut", "google_fit", "terra", "manual"
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId, date])
  @@index([burnoutRisk])
}
